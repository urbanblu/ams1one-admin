# Copy to .env.local and fill in. NEXT_PUBLIC_* values are inlined at build
# time, so they must also be set in the deploy environment before `next build`.

# Backend API origin, no trailing slash. Service paths are appended as /api/v1/...
NEXT_PUBLIC_API_BASE_URL=https://ams1onecore-production.up.railway.app

# One of: development | test | production. Drives EnvConstants.isDev/isStage/isProd.
NEXT_PUBLIC_APP_ENV=development
